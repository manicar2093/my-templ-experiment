model User {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String
  password    String
  created_at  DateTime @default(now())
  status      Status   @default(pending)
  can_login   Boolean  @default(false)
  indications String?

  @@map("users")
}

enum Status {
  active
  deactived
  pending
}
